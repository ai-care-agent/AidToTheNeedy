# /srv/aicare/backup.env: where `aicare backup` sends the nightly archive (chmod 600, never in git).
# rclone reads the remote from the RCLONE_CONFIG_* variables, so no rclone.conf is needed.

# Destination as <remote>:<bucket>/<folder>, one folder per server.
BACKUP_REMOTE=s3:aicare-backups-ACCOUNT_ID/prod

# AWS: the server's IAM role grants access (env_auth), so there are no keys here.
RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=AWS
RCLONE_CONFIG_S3_ENV_AUTH=true
RCLONE_CONFIG_S3_REGION=eu-central-1
RCLONE_CONFIG_S3_NO_CHECK_BUCKET=true
# The rclone in Ubuntu 24.04 sends an ACL with every upload. New AWS buckets accept only this one.
RCLONE_CONFIG_S3_ACL=bucket-owner-full-control

# Any other S3-compatible store (for example OVH Object Storage): replace the AWS lines above with
#   RCLONE_CONFIG_S3_PROVIDER=Other
#   RCLONE_CONFIG_S3_ENDPOINT=<the provider's S3 endpoint>
#   RCLONE_CONFIG_S3_REGION=<the provider's region>
#   RCLONE_CONFIG_S3_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=...

# Days to keep archives in the store.
BACKUP_KEEP_DAYS=30

# Optional: called after every successful backup (for example a Better Stack heartbeat), so that a
# missed backup raises an alert.
BACKUP_HEARTBEAT_URL=
