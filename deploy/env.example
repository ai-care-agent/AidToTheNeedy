# /srv/aicare/.env: settings and secrets of this server (chmod 600, never in git).
# deploy/aicare passes it to Docker Compose and to the app. Every app setting is described in the
# repository's .env.example.
# Put secrets in single quotes: Docker Compose expands an unquoted $, so DEMO_PASSWORD=$ecret would
# arrive empty and switch the password off.

# Public address. Caddy gets the HTTPS certificate for it, so DNS must point here first.
DOMAIN=staging.example.pl
# The same address with https://. Google Health and Withings redirect back to it.
PUBLIC_URL=https://staging.example.pl

# Claude API key. Without it the voice agent is off and Scam Shield uses local rules only.
ANTHROPIC_API_KEY=''

# One shared password for the whole site (the browser asks for it). `aicare deploy` refuses to run without it.
DEMO_PASSWORD=''

# Production: 0 keeps the household. Staging or a public demo: 1 gives a fresh demo household at 4:00.
DEMO_RESET_DAILY=0

APP_TZ=Europe/Warsaw
