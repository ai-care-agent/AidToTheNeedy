# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.

# Claude API key (https://platform.claude.com/) — required for the voice agent, Scam Shield and
# reading medicine boxes from photos.
# Without it the app still runs: the agent answers with a setup hint and Scam Shield
# falls back to local heuristics.
ANTHROPIC_API_KEY=

# Model and effort for the voice agent. Low effort keeps spoken replies fast.
# (AI_* rather than CLAUDE_* — some tools, e.g. Claude Code, export CLAUDE_EFFORT themselves.)
# Effort: low | medium | high | xhigh | max | off (off = parameter omitted, needed for
# models without effort support such as claude-haiku-4-5; also set AI_FALLBACKS=off there).
# AI_MODEL=claude-opus-5
# AI_EFFORT=low
# AI_SCAM_EFFORT=medium
# Server-side fallback to another model when a request is declined (on|off).
# AI_FALLBACKS=on

# Household settings
# APP_TZ=Europe/Warsaw
# Weather and air quality location (Open-Meteo, no key). WEATHER=off skips it.
# HOUSEHOLD_LAT=51.2465
# HOUSEHOLD_LON=22.5684
# WEATHER=on
# Orders above this total (zł) also need the family's approval after the senior confirms.
# SPENDING_LIMIT=150
# Minutes after which an unconfirmed medication reminder alerts the family.
# ESCALATE_AFTER_MIN=30
# Morning briefing and wellbeing question (HH:mm).
# CHECKIN_TIME=09:00
# Hours without any interaction (08:00–21:00) before the family status turns yellow.
# INACTIVITY_HOURS=6
# Daytime hours of silence before the app asks "Czy wszystko w porządku?", and minutes
# without an answer before the family gets an alert.
# SAFETY_CHECK_HOURS=4
# SAFETY_ESCALATE_MIN=15

# Real phone numbers for the "call" buttons (tel: links). Placeholders are used otherwise.
# SENIOR_PHONE=+48...
# CONTACT_ANNA_PHONE=+48...
# CONTACT_TOMEK_PHONE=+48...

# Health data from the cloud (both free for developers; without them the demo band and
# Web Bluetooth still work). Redirect URI to register: <PUBLIC_URL>/api/health/callback/google
# (or /withings). PUBLIC_URL is where the browser opens the app.
# GOOGLE_HEALTH_CLIENT_ID=
# GOOGLE_HEALTH_CLIENT_SECRET=
# WITHINGS_CLIENT_ID=
# WITHINGS_CLIENT_SECRET=
# PUBLIC_URL=http://localhost:5173

# First colours on a new phone (the web app reads this at build / dev-server start).
# The POC starts dark for demos; for real seniors use auto (light by day, dark after sunset).
# VITE_DEFAULT_THEME=dark

# Public demo (a link anyone can open):
# DEMO_PASSWORD=...     one shared password (the browser asks for it); unset = open link
# DEMO_RESET_DAILY=1    a fresh demo household every morning at 4:00

# PORT=8787
# DB_PATH=data/care.db
# AUDIO_DIR=data/audio
