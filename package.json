{
  "name": "ai-care-agent-poc",
  "private": true,
  "version": "0.1.0",
  "description": "AI Care Agent – POC: voice assistant for seniors + Family App + Scam Shield",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --disable-warning=ExperimentalWarning --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "reset-db": "tsx --disable-warning=ExperimentalWarning server/scripts/reset.ts",
    "backup-db": "tsx --disable-warning=ExperimentalWarning server/scripts/backup.ts",
    "dev:https": "HTTPS=1 npm run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
